# Шаблон ENV — скопируйте в apps/web/.env.local и заполните реальными значениями.
# Реальные секреты НИКОГДА не коммитим (проверка: apps/web/.gitignore → .env*).
# Полный справочник (что делает каждая, обязательна ли, что будет если не задать)
# — docs/reference/env-vars.md.

# ─── Supabase (server) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                   # SERVER ONLY — обходит RLS

# ─── Supabase (client, браузерный клиент через @supabase/ssr) ──
# Next.js инлайнит только NEXT_PUBLIC_*. Используется lib/supabase/browser.ts.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=                     # случайная строка, сверяется с X-Telegram-Bot-Api-Secret-Token
TELEGRAM_OPERATORS_GROUP_ID=                 # -100... ID группы операторов с forum-topics

# ─── AI ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# ─── Payments (Sprint 2) ───────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
CRYPTOBOT_TOKEN=
CRYPTOBOT_WEBHOOK_SECRET=

# ─── Love & Pay (MVP) ──────────────────────────────────────
# Кабинет — https://loveandpay.io. На preview — pk_test_*/sk_test_*, на prod — pk_live_*/sk_live_*.
# whsec_* выдаётся при регистрации webhook'а в кабинете (POST /api/v2/webhooks).
LOVEANDPAY_API_KEY=
LOVEANDPAY_SECRET_KEY=
LOVEANDPAY_WEBHOOK_SECRET=
LOVEANDPAY_BASE_URL=https://loveandpay.io/api/v2
# Минимум счёта в рублях (терминал KANYON не принимает < 500 ₽). Дефолт в коде = 500.
LOVEANDPAY_MIN_AMOUNT_RUB=500
# Discovery-флаг: '1' → webhook логирует реальные заголовки+тело ДО проверок
# (снять контракт L&P с живого вызова). По умолчанию выключен; снять после сверки.
LOVEANDPAY_WEBHOOK_DEBUG=

# ─── Freekassa (второй шлюз приёма рублей) ────────────────
# Кабинет — https://freekassa.net. Интеграция строго через API (не SCI-форма).
# Ключи задаются ТОЛЬКО на проде: на dev-стенде платёжных ключей нет намеренно,
# иначе тестовый заказ выставил бы реальный счёт.
FREEKASSA_API_KEY=
FREEKASSA_SHOP_ID=                           # ID магазина (число), обязателен в каждом запросе
FREEKASSA_SECRET_WORD_2=                     # проверка подписи ВХОДЯЩЕГО уведомления (MD5)
# FREEKASSA_SECRET_WORD_1 кодом НЕ читается — оно подписывает только SCI-форму,
# которую мы не используем. В env прода лежит про запас; здесь не объявляем,
# чтобы не создавать впечатление, что оно на что-то влияет.
FREEKASSA_BASE_URL=https://api.fk.life/v1
FREEKASSA_METHOD_ID=44                       # способ оплаты `i`: 44 СБП, 36 карты РФ
# IP ПЛАТЕЛЬЩИКА в запросе /orders/create, когда реальный неизвестен (заказ из
# бота/Mini App): 127.0.0.1 провайдер блокирует, шлём публичный IP нашего VPS.
# Это НЕ запасной шлюз — тот за PAYMENT_AUTO_FALLBACK.
FREEKASSA_FALLBACK_IP=187.124.172.104
FREEKASSA_INVOICE_TTL_HOURS=1                # НАШ срок ожидания оплаты: провайдер срок жизни заказа не отдаёт
FREEKASSA_MIN_AMOUNT_RUB=500                 # тот же порог, что у L&P — переключение не меняет доступные заказы
FREEKASSA_MAX_AMOUNT_RUB=140000              # лимит операции провайдера 150 000 ₽ (СБП и карты РФ), запас на комиссию покупателя
# Комиссия, которую провайдер накручивает ПЛАТЕЛЬЩИКУ поверх нашего счёта
# (ползунок в кабинете: 6% СБП / 7% карты). Мы её не берём — только показываем
# в UI и в боте. Обязана совпадать с настройкой кабинета; 0 — тексты скрыты.
FREEKASSA_BUYER_FEE_PERCENT=6
FREEKASSA_ALLOWED_IPS=                       # пусто → несовпадение IP уведомления только алёртим; задан список → отвергаем

# Кто принимает рубли ПРЯМО СЕЙЧАС: loveandpay | freekassa. Дефолт loveandpay
# (проверен живыми деньгами). Влияет ТОЛЬКО на создание нового счёта; вебхуки
# обоих провайдеров принимают деньги всегда. Смена = значение + redeploy.
PAYMENT_PRIMARY_PROVIDER=loveandpay

# Автофоллбэк на второй шлюз, когда основной не отвечает (таймаут/сеть/5xx).
# Дефолт выключен: включать, когда ОБА шлюза проверены живыми деньгами, иначе
# сбой основного уведёт поток на непроверенный контур. Требует ключей обоих.
PAYMENT_AUTO_FALLBACK=

# ─── app.pay.space (MVP) ──────────────────────────────────
# Кабинет — https://app.pay.space. Выпуск виртуальных USD-карт.
PAYSPACE_API_KEY=
PAYSPACE_ACCOUNT_ID=
PAYSPACE_BASE_URL=https://app.pay.space/api/v1

# Снапшот комиссии в percent (10 = 10%); дефолт в коде = 10
COMMISSION_PERCENT=10

# Fallback USDT→RUB курс, если публичный endpoint Rapira недоступен.
# Используется без дополнительной надбавки; при срабатывании пишется Sentry warning.
RATE_FALLBACK_USDT_RUB=77

# Внутренний токен для self-call'ов tool-handler → /api/payments/create.
# Сгенерировать: openssl rand -hex 32. Хранить в Vercel env как Sensitive.
INTERNAL_API_TOKEN=

# Авторизация cron-endpoint'ов (/api/cron/*). Vercel Cron шлёт его сам как
# `Authorization: Bearer <CRON_SECRET>`. На production без него authorizeCron
# вернёт 401. Сгенерировать: openssl rand -hex 32. (CRON_TOKEN — алиас на dev.)
CRON_SECRET=

# ─── Rate limit (Sprint 3, Upstash Ratelimit на /api/chat) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Background jobs (Sprint 3, Trigger.dev) ───────────────
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# ─── Observability ─────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                           # нужен только для source-map upload в CI build
NEXT_PUBLIC_SENTRY_DSN=                      # тот же DSN, но публичный — для client-side Sentry init
LOG_LEVEL=debug                              # fatal|error|warn|info|debug|trace; default: debug в dev, info в prod

# ─── App ───────────────────────────────────────────────────
APP_URL=https://oplati.example.com           # для формирования webhook URL и ссылок оплаты
NEXT_PUBLIC_APP_URL=https://oplati.example.com
NODE_ENV=development
