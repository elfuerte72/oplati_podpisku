# Шаблон ENV — скопируйте в apps/web/.env.local и заполните реальными значениями.
# Реальные секреты НИКОГДА не коммитим (проверка: apps/web/.gitignore → .env*).
# Полный справочник с источниками — docs/env-vars.md.

# ─── Supabase (server) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                   # SERVER ONLY — обходит RLS

# ─── Supabase (client, браузерный клиент через @supabase/ssr) ──
# Next.js инлайнит только NEXT_PUBLIC_*. Используется lib/supabase/browser.ts.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=                     # случайная строка, сверяется с X-Telegram-Bot-Api-Secret-Token
TELEGRAM_OPERATORS_GROUP_ID=                 # -100... ID группы операторов с forum-topics

# ─── AI ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# ─── Payments (Sprint 2) ───────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
CRYPTOBOT_TOKEN=
CRYPTOBOT_WEBHOOK_SECRET=

# ─── Love & Pay (MVP) ──────────────────────────────────────
# Кабинет — https://loveandpay.io. На preview — pk_test_*/sk_test_*, на prod — pk_live_*/sk_live_*.
# whsec_* выдаётся при регистрации webhook'а в кабинете (POST /api/v2/webhooks).
LOVEANDPAY_API_KEY=
LOVEANDPAY_SECRET_KEY=
LOVEANDPAY_WEBHOOK_SECRET=
LOVEANDPAY_BASE_URL=https://loveandpay.io/api/v2
# Минимум счёта в рублях (терминал KANYON не принимает < 500 ₽). Дефолт в коде = 500.
LOVEANDPAY_MIN_AMOUNT_RUB=500
# Discovery-флаг: '1' → webhook логирует реальные заголовки+тело ДО проверок
# (снять контракт L&P с живого вызова). По умолчанию выключен; снять после сверки.
LOVEANDPAY_WEBHOOK_DEBUG=

# ─── app.pay.space (MVP) ──────────────────────────────────
# Кабинет — https://app.pay.space. Выпуск виртуальных USD-карт.
PAYSPACE_API_KEY=
PAYSPACE_ACCOUNT_ID=
PAYSPACE_BASE_URL=https://app.pay.space/api/v1

# Снапшот комиссии в percent (10 = 10%); дефолт в коде = 10
COMMISSION_PERCENT=10

# Fallback USDT→RUB курс, если L&P /rates вернёт RATE_NOT_FOUND или сетевую ошибку.
# Используется в propose_order; при срабатывании пишется Sentry warning.
# Когда L&P активирует курс — fallback автоматически перестанет использоваться.
RATE_FALLBACK_USDT_RUB=95

# Внутренний токен для self-call'ов tool-handler → /api/payments/create.
# Сгенерировать: openssl rand -hex 32. Хранить в Vercel env как Sensitive.
INTERNAL_API_TOKEN=

# Авторизация cron-endpoint'ов (/api/cron/*). Vercel Cron шлёт его сам как
# `Authorization: Bearer <CRON_SECRET>`. На production без него authorizeCron
# вернёт 401. Сгенерировать: openssl rand -hex 32. (CRON_TOKEN — алиас на dev.)
CRON_SECRET=

# ─── Rate limit (Sprint 3, Upstash Ratelimit на /api/chat) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Background jobs (Sprint 3, Trigger.dev) ───────────────
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# ─── Observability ─────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                           # нужен только для source-map upload в CI build
NEXT_PUBLIC_SENTRY_DSN=                      # тот же DSN, но публичный — для client-side Sentry init
LOG_LEVEL=debug                              # fatal|error|warn|info|debug|trace; default: debug в dev, info в prod

# ─── App ───────────────────────────────────────────────────
APP_URL=https://oplati.example.com           # для формирования webhook URL и ссылок оплаты
NEXT_PUBLIC_APP_URL=https://oplati.example.com
NODE_ENV=development
