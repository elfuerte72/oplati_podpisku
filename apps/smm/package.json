{
  "name": "smm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:llm": "node evals/llm-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "grammy": "^1.46.0",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "eslint": "^9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.4"
  }
}
