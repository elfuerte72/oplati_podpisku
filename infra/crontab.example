# Cron-джобы Оплатишки для self-host (Dokploy/VPS) — замена Vercel Cron.
# ЕДИНСТВЕННЫЙ источник расписаний: блок `crons` снят из apps/web/vercel.json
# 2026-07-24 (два парка кронов на разных БД = двойной фулфилмент, см.
# docs/dokploy-cutover-report.md, S-1/B-1).
#
# Установка (Фаза 2.5 docs/dokploy-migration-plan.md):
#   1. Скопировать на VPS:  scp infra/crontab.example root@VPS:/etc/cron.d/oplatishka
#   2. Положить СЕКРЕТ в отдельный файл (находка S-3 закрыта 2026-07-28), а не
#      в командную строку:
#        mkdir -p /etc/oplatishka && chmod 700 /etc/oplatishka
#        printf 'header = "Authorization: Bearer %s"\n' '<секрет>' > /etc/oplatishka/cron.conf
#        chmod 600 /etc/oplatishka/cron.conf
#      ⚠️ Так секрет НЕ попадает ни в /var/log/syslog (cron логирует всю строку
#      при каждом запуске), ни в `ps`, ни в /proc/<pid>/cmdline. До этой правки
#      он лежал в syslog открытым текстом — 305 записей за 17 часов, поэтому его
#      пришлось ротировать. Секрет даёт `retention` (удаление messages) и
#      `recycle-cards` (реальный release карт = деньги).
#   3. Заменить базовый URL:
#        sed -i 's|__BASE_URL__|https://www.oplatishka.com|' /etc/cron.d/oplatishka
#   4. chown root:root /etc/cron.d/oplatishka && chmod 600 /etc/cron.d/oplatishka
#      Секрета в файле больше нет, но 600 оставляем: расписание и адреса джобов —
#      тоже не публичная информация.
#   5. Проверка: `grep oplatishka-cron /var/log/syslog` + ручной вызов
#      `curl --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/poll-payment`.
#
# Авторизация: cron-роуты принимают `Authorization: Bearer <CRON_SECRET>`
# (тот же контракт, что у Vercel Cron) — код роутов не менялся. Заголовок
# подставляет curl из `--config`, поэтому в crontab секрета нет.
#
# РОТАЦИЯ секрета (порядок важен, окно 401 ≈ время перезапуска):
#   1. openssl rand -hex 32 → новый секрет;
#   2. переписать /etc/oplatishka/cron.conf;
#   3. обновить CRON_SECRET в env приложения Dokploy + redeploy
#      (docs/runbooks/deploy.md → раздел про API панели);
#   4. проверить `curl --config … /api/cron/poll-payment` → 200 и старым
#      секретом → 401.
#
# `-m 290` (таймаут curl) < maxDuration=300 роутов.
# `2>&1 >/dev/null | logger` — ИМЕННО в этом порядке: сначала stderr дублируется
# в пайп, потом stdout уходит в /dev/null. Иначе (`>/dev/null 2>&1`) stderr
# утёк бы в /dev/null. Нужно потому, что cron отдаёт stderr не в syslog, а в MTA,
# которого на VPS нет (проверено: ни sendmail, ни postfix, ни exim4) и MAILTO не
# задан — без этой обвязки отвал джоба (401 после ротации секрета, протухший
# сертификат, лежит Traefik) был бы ПОЛНОСТЬЮ невидим, а `poll-payment` —
# единственный backstop потерянных webhook'ов L&P (находки B-3/E-1).
# На успехе curl молчит → logger не пишет ничего, лог не пухнет.
# Внешний heartbeat (Better Stack) на факт прогона — отдельная задача, см. BACKLOG.
#
# `flock -n` на poll-payment: интервал 300 с при таймауте 290 с почти смыкается,
# а перекрытие запусков нежелательно (побочки защищены атомарными claim'ами,
# так что это подстраховка, а не единственная защита).
#
# `keepalive` из старого vercel.json НЕ переносим: он анти-автопауза Supabase
# free tier, у self-host Postgres автопаузы нет (см. план, Фаза 1.7).

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ТРЕБОВАНИЕ К ХОСТУ: TZ = UTC. Расписания ниже перенесены из Vercel Cron,
# который всегда UTC, а cron исполняет их в TZ ХОСТА. `CRON_TZ` здесь НЕ
# ставим — Ubuntu/Debian cron 3.0pl1 его не поддерживает (проверено:
# `strings /usr/sbin/cron | grep -x CRON_TZ` пусто), директива была бы
# молчаливой пустышкой. Держать UTC на уровне системы:
#   timedatectl                      # ожидаем "Time zone: Etc/UTC"
#   timedatectl set-timezone UTC     # если уехало
# Иначе `referral-rollup` (0 2 1 * *) уедет в прошлый месяц, где
# PK-идемпотентность превратит промах в тихий skip и месяц прогрессии
# не начислится вообще (находка A-4). Сейчас на VPS Etc/UTC — проверено.

# Подстраховка webhook'ов L&P + recovery зависших paid + healthcheck (каждые 5 мин)
# ⚠️ Установленный на VPS файл (2026-07-28) отличается от этого шаблона формой строки:
#   `curl … --resolve www.oplatishka.com:443:127.0.0.1 … https://www.oplatishka.com/api/cron/<job>`
#   (мимо DNS, прямо в локальный Traefik) и тег `logger -t oplatishka-cron-<job>` вместо общего
#   `-t oplatishka-cron -p cron.err`; `flock` у poll-payment там не стоит. Добавляя джоб на
#   живом сервере, бери образец с СОСЕДНЕЙ строки файла, а не отсюда — так добавлен
#   support-housekeeping 2026-08-28. Шаблон остаётся источником расписания и списка джобов.
*/5 * * * *  root  flock -n /var/lock/oplatishka-poll-payment.lock curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/poll-payment 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err

# Похороны просроченных заказов: pending_payment + протухшие черновики (каждые 15 мин)
*/15 * * * * root  curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/expire-payments 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err

# Напоминание о продлении подписки (ежедневно 07:00 UTC)
0 7 * * *    root  curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/renewal-reminder 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err

# Recycle карт: закрытие карт старше CARD_LIFETIME_DAYS (release) + алёрт низкого VCC-баланса (ежедневно 03:30 UTC)
30 3 * * *   root  curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/recycle-cards 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err

# Retention: чистка messages >90д, raw_payload >180д (ежедневно 04:15 UTC)
15 4 * * *   root  curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/retention 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err

# Добор пропущенных реферальных начислений (каждый час, :15)
15 * * * *   root  curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/referral-recovery 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err

# Хозяйство поддержки: автозакрытие разговоров у оператора после 24 ч тишины клиента
# + алёрт «обращение без ответа > 2 ч» в рабочее время (каждые 15 мин, :07)
7-59/15 * * * * root  curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/support-housekeeping 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err

# Месячная прогрессия партнёрских статусов (1-е число, 02:00 UTC)
0 2 1 * *    root  curl -fsS -m 290 --config /etc/oplatishka/cron.conf __BASE_URL__/api/cron/referral-rollup 2>&1 >/dev/null | logger -t oplatishka-cron -p cron.err
