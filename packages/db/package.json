{
  "name": "@oplati/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./migrations-journal": "./migrations/meta/_journal.json"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=../../.env scripts/seed-catalog.ts",
    "db:init-roles": "tsx --env-file=../../.env scripts/init-roles.ts",
    "db:staff": "tsx --env-file=../../.env scripts/manage-staff.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oplati/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
